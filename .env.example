# [단일 봇 사용 시]
DISCORD_TOKEN=your_primary_discord_bot_token_here

# [다중 봇 사용 시] 여러 봇 토큰을 아래처럼 추가하거나 쉼표(,)로 연결할 수 있습니다.
# 다른 음성 채널에서 동시에 재생할 때 쉬고 있는 서브 봇이 자동으로 출동합니다.
# DISCORD_TOKEN_2=your_second_bot_token_here
# DISCORD_TOKEN_3=your_third_bot_token_here
# 또는:
# DISCORD_TOKENS=token1,token2,token3

# (선택 사항) ffmpeg.exe 경로 직접 지정 (PATH나 패키지에 기본 내장되어 있어 보통 비워두셔도 됩니다)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
